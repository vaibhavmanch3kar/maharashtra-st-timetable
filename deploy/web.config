<?xml version="1.0" encoding="utf-8"?>
<!--
  MSRTC Timetable — IIS configuration (Windows Server 2016+ / IIS 10)

  Drop this file in the site root alongside index.html.

  Prerequisites — install these Windows features first, or the rules below
  are silently ignored:
    - IIS URL Rewrite Module 2.1   (rewrite rules)
    - IIS Dynamic Compression      (Brotli/gzip for the 130 KB HTML)
  Verify:  Get-WindowsFeature Web-Http-Redirect, Web-Dyn-Compression

  Two IIS-specific traps this file works around:
    1. staticContent MIME types are ADDITIVE and IIS throws HTTP 500.19 on a
       duplicate. Every <mimeMap> is preceded by a <remove> for that reason.
    2. IIS serves .json and .webmanifest as 404 by default because they are
       not in the inherited MIME map at all.
-->
<configuration>
  <system.webServer>

    <!-- ================= DEFAULT DOCUMENT ========================= -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ================= MIME TYPES ==============================
         .json / .webmanifest are absent from the IIS default map, so the
         PWA manifest 404s without these. Remove-then-add avoids 500.19
         when a parent applicationHost.config already declares one.       -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json"        mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js"          mimeType="text/javascript" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2"       mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg"         mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp"        mimeType="image/webp" />

      <!-- Default cache header for static assets. index.html and sw.js are
           overridden below — they must never be cached this aggressively. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!-- ================= COMPRESSION =============================
         The single-file HTML is ~130 KB with the timetable embedded and
         compresses to roughly 30 KB. Without this the payload is four times
         larger than it needs to be over rural 3G, which is exactly the
         network this app is for.                                          -->
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="br"   dll="%Windir%\system32\inetsrv\iisbrotli.dll" staticCompressionLevel="9" />
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll"      staticCompressionLevel="9" />
      <staticTypes>
        <clear />
        <add mimeType="text/*"                     enabled="true" />
        <add mimeType="application/javascript"     enabled="true" />
        <add mimeType="text/javascript"            enabled="true" />
        <add mimeType="application/json"           enabled="true" />
        <add mimeType="application/manifest+json"  enabled="true" />
        <add mimeType="image/svg+xml"              enabled="true" />
        <add mimeType="*/*"                        enabled="false" />
      </staticTypes>
    </httpCompression>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- ================= HEADERS ================================== -->
    <httpProtocol>
      <customHeaders>
        <!-- IIS advertises its version and ASP.NET presence by default.
             Both are free reconnaissance for an attacker. -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options"        value="SAMEORIGIN" />
        <add name="Referrer-Policy"        value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy"     value="geolocation=(self), camera=(), microphone=(), payment=()" />

        <!-- CSP. 'unsafe-inline' and 'unsafe-eval' are required and are a
             direct cost of two brief decisions:
               - unsafe-inline : the app is a single file, so all script and
                                 style is inline by construction.
               - unsafe-eval   : the Tailwind CDN compiles utility classes at
                                 runtime and will not start without it.
             Both disappear if you build Tailwind ahead of time and move the
             script to an external file. See the deployment notes. -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>

    <!-- ================= REWRITE / CACHE OVERRIDES ================ -->
    <rewrite>
      <rules>
        <!-- Force HTTPS. Service workers do not register over plain http on
             any host other than localhost, so without this the offline
             feature is simply dead in production. -->
        <rule name="HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- SPA-style fallback: unknown paths that are not real files serve
             index.html so deep links and the PWA start_url both resolve. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(sw\.js|manifest\.json)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>

      <outboundRules>
        <!-- sw.js MUST NOT be cached. A cached service worker cannot be
             replaced, so a stale one pins users to an old timetable
             permanently. This is the single most common PWA deployment
             failure and it is unrecoverable without a manual cache purge. -->
        <rule name="No-cache for service worker" preCondition="IsServiceWorker">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>

        <!-- index.html carries the timetable, so it must revalidate on every
             load. The ETag makes that a cheap 304 in the common case. -->
        <rule name="Revalidate index" preCondition="IsIndex">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, must-revalidate" />
        </rule>

        <preConditions>
          <preCondition name="IsServiceWorker">
            <add input="{REQUEST_URI}" pattern="sw\.js$" />
          </preCondition>
          <preCondition name="IsIndex">
            <add input="{REQUEST_URI}" pattern="(^/$|index\.html$)" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- ================= ERROR PAGES ============================== -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Hide the directory listing. Serving a file index of the site root
         is an information leak, not a feature. -->
    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
